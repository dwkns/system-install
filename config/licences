# App licences, restored from the macOS keychain at setup time.
#   <keychain service name>|<destination path>
#
# Licences are never stored in this repo. Add one to the keychain with:
#   openssl base64 -A -in <licence file> |
#     security add-generic-password -U -a "$USER" -s <service name> -w "$(cat)"
sublime-text-license|$HOME/Library/Application Support/Sublime Text/User/License.sublime_license
