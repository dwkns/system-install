.DS_Store
__pycache__/

# Copies of system files replaced by the last sync
.drift/

# Local state (which one-time steps have run)
.state/

# Public keys live in config/ssh/keys/*.pub and are meant to be shared. Nothing
# else from SSH ever goes in: this makes an accidental private key impossible.
.ssh/
id_*
*.pem
known_hosts*

# Secrets live in 1Password (vault "Dev secrets"), never here. These are the
# shapes a stray one would take.
.op-service-token
.env
.secrets/
*.p8
*.p12
*.cer
