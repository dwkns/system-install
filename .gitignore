.DS_Store
.ruby-lsp/

# Licences never go in the repo — they live in 1Password (see config/licences)
*.sublime_license

# Copies of system files replaced by the last sync
.drift/

# Local state (which one-time steps have run)
.state/

# Never commit SSH material. `sys ssh` reads ~/.ssh live and stores nothing,
# but this makes an accidental copy into the repo impossible.
.ssh/
id_*
!*.pub.example
*.pem
known_hosts*
