#!/usr/bin/env python3
"""List the machines this one can reach over SSH (`sys ssh`).

Status, not guesswork: every machine in config/ssh/access is shown with both
of its routes actually probed — the Tailscale name, and NAME.local on the home
network — so "not reachable" means this machine just tried and failed, and
Tailscale being off is stated once rather than making every row look broken.

  sys ssh       the machines sys manages
  sys ssh all   those, plus anything hand-written in ~/.ssh/config
"""
import concurrent.futures, glob, json, os, pathlib, socket, subprocess, sys

G, C, Y, D, B, R = "\033[0;32m", "\033[0;36m", "\033[0;33m", "\033[2m", "\033[1m", "\033[0m"
SSH_DIR = pathlib.Path.home() / ".ssh"
MANAGED = SSH_DIR / "config.d" / "sys"
ROOT = pathlib.Path(os.environ.get("ROOT_DIR", pathlib.Path.home() / ".system-config"))
ACCESS = ROOT / "config" / "ssh" / "access"
SHOW_ALL = "all" in sys.argv[1:]
TIMEOUT = 2.0


def rule(title, emoji):
    line = "─" * 56
    print(f"\n{D}{line}{R}\n {emoji}  {B}{title}{R}\n{D}{line}{R}\n")


def reachable(host, port=22):
    """Is anything answering on port 22? The only question that matters."""
    try:
        socket.create_connection((host, port), timeout=TIMEOUT).close()
        return True
    except Exception:
        return False


def access_rows():
    """machine, account — from config/ssh/access, this machine left out."""
    me = socket.gethostname().split(".")[0].lower()
    rows = []
    if not ACCESS.is_file():
        return me, rows
    for raw in ACCESS.read_text(errors="replace").splitlines():
        line = raw.split("#", 1)[0].split()
        if len(line) >= 2 and line[0] != me:
            rows.append((line[0], line[1]))
    return me, rows


def tailscale_state():
    """(running, self name). running is False when the daemon is off or
    logged out — the case that used to be reported as every host being stale."""
    for cmd in ("tailscale", "/Applications/Tailscale.app/Contents/MacOS/Tailscale",
                "/usr/local/bin/tailscale"):
        try:
            out = subprocess.run([cmd, "status", "--json"], capture_output=True,
                                 timeout=10, check=True).stdout
        except Exception:
            continue
        try:
            d = json.loads(out)
        except ValueError:
            continue
        if (d.get("BackendState") or "") != "Running":
            return False, ""
        me = (d.get("Self") or {}).get("DNSName", "").rstrip(".").split(".")[0]
        return True, me
    return False, ""


def ssh_config_hosts(path=SSH_DIR / "config", seen=None, by_alias=None):
    """Host blocks from ~/.ssh/config, following Include lines."""
    seen = seen if seen is not None else set()
    by_alias = by_alias if by_alias is not None else {}
    if not path.is_file() or path in seen:
        return []
    seen.add(path)
    hosts, cur = [], []
    for raw in path.read_text(errors="replace").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 1)
        key = parts[0].lower()
        val = parts[1].strip() if len(parts) > 1 else ""
        if key == "include":
            for pattern in val.split():
                pattern = os.path.expanduser(pattern)
                if not os.path.isabs(pattern):
                    pattern = str(SSH_DIR / pattern)
                for inc in sorted(glob.glob(pattern)):
                    hosts.extend(ssh_config_hosts(pathlib.Path(inc), seen, by_alias))
            cur = []
        elif key == "match":
            cur = []
        elif key == "host":
            cur = []
            for alias in val.split():
                if "*" in alias or "?" in alias:
                    continue
                if alias not in by_alias:
                    by_alias[alias] = {"alias": alias, "hostname": "", "user": "",
                                       "managed": path == MANAGED}
                    hosts.append(by_alias[alias])
                cur.append(by_alias[alias])
        elif cur and key in ("hostname", "user"):
            for h in cur:
                h[key] = h[key] or val
    return hosts


def alias_of(machine, machines):
    """dwkns-mini-m1 -> mini-m1, when every machine shares the first segment."""
    if not all("-" in m for m in machines):
        return machine
    prefix = machines[0].split("-")[0] + "-"
    if all(m.startswith(prefix) and len(m) > len(prefix) for m in machines):
        return machine[len(prefix):]
    return machine


me, rows = access_rows()
ts_on, ts_self = tailscale_state()

# Probe everything at once: two routes per machine, two seconds each at worst.
targets = []
for machine, account in rows:
    targets.append((machine, "tailnet", machine))
    targets.append((machine, "local", machine + ".local"))
extra = []
if SHOW_ALL:
    managed_aliases = {alias_of(m, [r[0] for r in rows]) for m, _ in rows}
    for h in ssh_config_hosts():
        if h["managed"] or h["alias"] in managed_aliases or not h["hostname"]:
            continue
        extra.append(h)
        targets.append((h["alias"], "direct", h["hostname"]))

with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:
    results = dict(zip([(t[0], t[1]) for t in targets],
                       pool.map(lambda t: reachable(t[2]), targets)))

rule("SSH hosts", "🔌")

if ts_on:
    print(f"  {G}Tailscale on{R}{D} — this machine is {ts_self}{R}")
else:
    print(f"  {Y}Tailscale off{R}{D} — home network only, so anything elsewhere is out of reach{R}")
print()

if not rows:
    print(f"  {D}Nothing in config/ssh/access yet{R}\n")

machines = [r[0] for r in rows]
width = max([len(alias_of(m, machines)) for m in machines] + [8])
for machine, account in rows:
    a = alias_of(machine, machines)
    tail = results.get((machine, "tailnet"), False)
    local = results.get((machine, "local"), False)

    def mark(ok, label):
        return f"{G}{label} ✓{R}" if ok else f"{D}{label} ✗{R}"

    if tail or local:
        via = f"  {mark(tail, 'tailnet')}  {mark(local, 'home')}"
        head = f"  {G}ssh {a:<{width}}{R}"
    else:
        via = f"  {Y}not reachable{R}"
        head = f"  {D}ssh {a:<{width}}{R}"
    print(f"  {head} {D}{account}@{machine}{R}{via}")

print()
if extra:
    print(f"  {B}Hand-written in ~/.ssh/config{R}")
    ewidth = max(len(h["alias"]) for h in extra)
    for h in extra:
        ok = results.get((h["alias"], "direct"), False)
        who = f'{h["user"]}@' if h["user"] else ""
        state = f"{G}reachable ✓{R}" if ok else f"{D}not reachable ✗{R}"
        print(f'  {G}ssh {h["alias"]:<{ewidth}}{R} {D}{who}{h["hostname"]}{R}  {state}')
    print()

if not SHOW_ALL:
    print(f"  {D}sys ssh all also lists hosts hand-written in ~/.ssh/config.{R}")
print(f"  {D}Who may log in where: config/ssh/access. Edit it, sys push, then sys sync.{R}\n")
