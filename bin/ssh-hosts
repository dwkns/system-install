#!/usr/bin/env python3
"""List the machines this one can reach over SSH (`sys ssh`).

Read live from the machine — ~/.ssh/config (following Include lines) and the
Tailscale daemon. Entries that sys wrote from config/ssh/access are listed
first; anything hand-written in ~/.ssh/config follows, and is flagged when its
address is not a machine on your tailnet.
"""
import glob, json, os, pathlib, subprocess, sys

G, C, Y, D, B, R = "\033[0;32m", "\033[0;36m", "\033[0;33m", "\033[2m", "\033[1m", "\033[0m"
SSH_DIR = pathlib.Path.home() / ".ssh"
MANAGED = SSH_DIR / "config.d" / "sys"

def rule(title, emoji):
    line = "─" * 56
    print(f"\n{D}{line}{R}\n {emoji}  {B}{title}{R}\n{D}{line}{R}\n")

def ssh_config_hosts(path=SSH_DIR / "config", seen=None, by_alias=None):
    """Host blocks, ignoring wildcards. Include lines are followed, relative
    to ~/.ssh. A line naming several aliases (a shared-settings block) applies
    to each; the first value for a setting wins, as in ssh itself."""
    seen = seen if seen is not None else set()
    by_alias = by_alias if by_alias is not None else {}
    if not path.is_file() or path in seen:
        return []
    seen.add(path)
    hosts, cur = [], []
    for raw in path.read_text(errors="replace").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 1)
        key = parts[0].lower()
        val = parts[1].strip() if len(parts) > 1 else ""
        if key == "include":
            for pattern in val.split():
                pattern = os.path.expanduser(pattern)
                if not os.path.isabs(pattern):
                    pattern = str(SSH_DIR / pattern)
                for inc in sorted(glob.glob(pattern)):
                    hosts.extend(ssh_config_hosts(pathlib.Path(inc), seen, by_alias))
            cur = []
        elif key == "match":
            cur = []          # a Match block is a route choice, not a host
        elif key == "host":
            cur = []
            for alias in val.split():
                if "*" in alias or "?" in alias:
                    continue
                if alias not in by_alias:
                    by_alias[alias] = {"alias": alias, "hostname": "", "user": "", "port": "",
                                       "hostkeyalias": "", "managed": path == MANAGED}
                    hosts.append(by_alias[alias])
                cur.append(by_alias[alias])
        elif cur and key in ("hostname", "user", "port", "hostkeyalias"):
            for h in cur:
                h[key] = h[key] or val
    return hosts

def tailnet():
    """Peers plus this machine, from whichever tailscale binary exists."""
    for cmd in ("tailscale", "/Applications/Tailscale.app/Contents/MacOS/Tailscale",
                "/usr/local/bin/tailscale"):
        try:
            out = subprocess.run([cmd, "status", "--json"], capture_output=True,
                                 timeout=10, check=True).stdout
        except Exception:
            continue
        d = json.loads(out)
        rows, me = [], d.get("Self") or {}
        for p in list((d.get("Peer") or {}).values()) + ([me] if me else []):
            ips = p.get("TailscaleIPs") or []
            dns = (p.get("DNSName") or "").rstrip(".")
            rows.append({
                # DNSName is the MagicDNS name; HostName can be "localhost" on phones.
                "name": dns.split(".")[0] if dns else (p.get("HostName") or "?"),
                "ip": ips[0] if ips else "",
                "os": p.get("OS") or "",
                "online": bool(p.get("Online")),
                "self": p is me,
            })
        return sorted(rows, key=lambda r: (not r["online"], r["name"]))
    return None

net = tailnet()

cfg = ssh_config_hosts()
known = {r["name"] for r in net} if net else set()

rule("SSH hosts", "🔌")

def show(h):
    # A managed entry has two routes (Tailscale, then NAME.local); show the
    # machine it means, which HostKeyAlias carries, rather than either route.
    target = h["hostkeyalias"] or h["hostname"] or h["alias"]
    who = f'{h["user"]}@' if h["user"] else ""
    port = f' {D}port {h["port"]}{R}' if h["port"] else ""
    print(f'    {G}ssh {h["alias"]:<12}{R} {D}→ {who}{target}{R}{port}')
    if known and target.split(".")[0] not in known:
        print(f'                     {Y}not on your tailnet — an old entry?{R}')

managed = [h for h in cfg if h["managed"]]
manual = [h for h in cfg if not h["managed"]]
if managed:
    print(f"  {B}From config/ssh/access{R}  {D}(sys sync keeps these current){R}")
    for h in managed:
        show(h)
    print()
else:
    print(f"  {D}Nothing from config/ssh/access yet — sys sync sets it up{R}\n")
if manual:
    print(f"  {B}Hand-written in ~/.ssh/config{R}")
    for h in manual:
        show(h)
    print()

print(f"  {D}Who may log in where: config/ssh/access in the repo.{R}")
print(f"  {D}Edit it, sys push, then sys sync on each machine.{R}\n")
