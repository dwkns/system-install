#!/usr/bin/env bash
# One entry point for everything. Run `sys` with no arguments for help.
set -euo pipefail

export ROOT_DIR="${ROOT_DIR:-$HOME/.system-config}"
source "$ROOT_DIR/lib/common.sh"
source "$ROOT_DIR/lib/sync.sh"
source "$ROOT_DIR/lib/setup.sh"

usage() {
  cat <<'USAGE'
sys — system configuration

  sys setup     Set up this machine from scratch
  sys sync      Pull the latest config and apply it to this machine
  sys push      Save this machine's config into the repo and push
  sys doctor    Check that everything is where it should be
  sys alias     List your custom aliases and functions
  sys mise      How to use mise for language versions
  sys extras    Install the optional extras (Office, Xcode, ollama, duckdb)

Options
  --dry-run           Show what would happen, change nothing
  --yes               Don't ask for confirmation
  --name NAME         (setup) Set the computer name
  --no-brew           (setup) Skip Homebrew and packages
  --no-macos          (setup/sync) Skip macOS defaults
  --licences          (setup) Only install licences from the keychain
  --mas               (setup) Only install App Store apps

Full documentation: man sys
USAGE
}

cmd="${1:-}"; [[ $# -gt 0 ]] && shift

DO_BREW=1 DO_MACOS=1 ONLY="" NAME=""
export DRY_RUN="${DRY_RUN:-0}" ASSUME_YES="${ASSUME_YES:-0}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)  DRY_RUN=1 ;;
    --yes|-y)   ASSUME_YES=1 ;;
    --no-brew)  DO_BREW=0 ;;
    --no-macos) DO_MACOS=0 ;;
    --licences|--licenses) ONLY="licences" ;;
    --mas)      ONLY="mas" ;;
    --name)     NAME="${2:-}"; shift ;;
    *) die "Unknown option: $1" ;;
  esac
  shift
done

case "$cmd" in
  setup)
    is_macos || die "macOS only."

    case "$ONLY" in
      licences) install_licences; exit 0 ;;
      mas)      install_app_store_apps; exit 0 ;;
    esac

    confirm "Set up this machine from $ROOT_DIR?" || exit 0
    [[ -n "$NAME" ]] && sudo -v

    [[ "$DO_BREW"  == "1" ]] && install_packages
    doing "Installing dotfiles"
    sync_install
    install_languages
    install_licences
    install_app_store_apps
    set_machine_name "$NAME"
    [[ "$DO_MACOS" == "1" ]] && { apply_macos_defaults; set_default_terminal; }

    doing "Setup complete"
    print_manual_steps
    ;;

  sync)
    doing "Fetching latest config"
    run git -C "$ROOT_DIR" pull --ff-only
    doing "Installing dotfiles"
    sync_install
    [[ "$DO_MACOS" == "1" ]] && apply_macos_defaults
    doing "Done — run 'exec zsh' to reload your shell"
    ;;

  push)
    doing "Saving this machine's config into the repo"
    sync_backup
    # keep the Cursor extension list from drifting
    has_cmd cursor && cursor --list-extensions 2>/dev/null | sort > "$ROOT_DIR/config/cursor-extensions.txt"
    if [[ -n "$(git -C "$ROOT_DIR" status --porcelain)" ]]; then
      git -C "$ROOT_DIR" add -A
      git -C "$ROOT_DIR" commit -m "Update config files"
      run git -C "$ROOT_DIR" push
      doing "Pushed"
    else
      note "Nothing changed"
    fi
    ;;

  doctor)
    doing "Checking this machine"
    tools="git brew mise uv gh jq mas duti"; missing=""
    for t in $tools; do has_cmd "$t" || missing="$missing $t"; done
    if [[ -z "$missing" ]]; then note "tools: all present ($(echo $tools | sed 's/ /, /g'))"
    else warn "missing:$(echo $missing | sed 's/ /, /g')"; fi
    has_cmd mise && { mise ls --current 2>/dev/null | sed 's/^/    /'; }
    while IFS='|' read -r svc _; do
      [[ -z "$svc" || "$svc" == \#* ]] && continue
      security find-generic-password -a "$USER" -s "$svc" -w >/dev/null 2>&1 \
        && note "licence '$svc': in keychain" || warn "licence '$svc': missing — sys setup --licences"
    done < "$ROOT_DIR/config/licences"
    has_cmd mas && { with_timeout 10 mas list && note "App Store: reachable" || warn "App Store: not signed in"; }
    [[ -z "$(git -C "$ROOT_DIR" status --porcelain)" ]] && note "Repo is clean" || warn "Repo has uncommitted changes — 'sys push'"
    ;;

  alias|aliases)
    file="$ROOT_DIR/dotfiles/.aliases"
    [[ -r "$file" ]] || die "Not found: $file"
    awk -v g="$GREEN" -v c="$CYAN" -v y="$YELLOW" -v r="$RESET" '
      # A comment containing box-drawing rule is a section header. Tested
      # byte-wise with index() so it works whatever locale awk runs in.
      /^#/ {
        if (index($0, "\xe2\x94\x80") > 0) {
          h = $0
          gsub(/[^ -~]/, "", h)          # strip non-ASCII (the rule)
          sub(/^# */, "", h); sub(/ *$/, "", h)
          if (h != "") printf "\n%s%s%s\n", c, h, r
          desc = ""; next
        }
        desc = $0; sub(/^# */, "", desc); next
      }
      # alias name='"'"'command'"'"'   (trailing # comment is the description)
      /^alias / {
        line = $0; sub(/^alias /, "", line)
        eq = index(line, "=")
        name = substr(line, 1, eq - 1)
        rest = substr(line, eq + 1)
        note = ""
        if (match(rest, /[ \t]+#[ \t]*/)) {
          note = substr(rest, RSTART + RLENGTH)
          rest = substr(rest, 1, RSTART - 1)
        }
        gsub(/^['"'"'"]|['"'"'"]$/, "", rest)
        printf "  %s%-8s%s %s%s%s\n", g, name, r, y, rest, r
        if (note != "") printf "  %8s   %s\n", "", note
        desc = ""; next
      }
      # shell function:  name() {
      /^[a-z_][a-z0-9_]*\(\)/ {
        fn = $0; sub(/\(\).*/, "", fn)
        printf "  %s%-8s%s %s%s%s\n", g, fn, r, y, (desc == "" ? "function" : desc), r
        desc = ""; next
      }
      { desc = "" }
    ' "$file"
    proj="$ROOT_DIR/dotfiles/.projects"
    if [[ -r "$proj" ]]; then
      printf '\n%sProject starters%s\n' "$CYAN" "$RESET"
      grep -E "^[a-z]+\(\)  *\{ _new_project" "$proj" | while read -r l; do
        n="${l%%(*}"; d="$(printf '%s' "$l" | sed -E 's/.*_new_project ([^ ]+).*/\1/')"
        printf '  %s%-8s%s %s%s%s\n' "$GREEN" "$n" "$RESET" "$YELLOW" "$d" "$RESET"
      done
    fi
    echo
    ;;

  extras)
    is_macos || die "macOS only."
    install_extras
    ;;

  mise)
    cat <<'MISE'

mise manages your Ruby, Node and Python versions.

  Global versions live in ~/.config/mise/config.toml, tracked in this repo as
  dotfiles/.config/mise/config.toml. Edit it, run `sys push`, then `mise install`.

Everyday
  mise ls                     what is installed, and what is active here
  mise current                just the active versions
  mise install                install everything the config asks for
  mise outdated               what has newer versions available
  mise upgrade                move up within the versions you have pinned

Change a version
  mise use -g ruby@3.4.8      change the GLOBAL default (edits the config)
  mise use ruby@3.3           pin for THIS project (writes ./mise.toml)
  mise ls-remote ruby         what versions exist
  mise exec ruby@3.2 -- ruby -v    run once, change nothing

Per project
  A ./mise.toml overrides the global versions and activates when you cd in.
  mise trust                  allow a mise.toml you did not write

Python packages
  mise supplies the interpreter; uv does packages and virtualenvs.
  uv venv                     create .venv with the active python
  uv pip install -r requirements.txt
  uv add <pkg>                for pyproject.toml projects
  uv run <script.py>          run in the project env, installing as needed

Where things live
  ~/.config/mise/config.toml       global versions (tracked in this repo)
  ./mise.toml                      per-project override (commit it)
  ~/.local/share/mise/installs     the toolchains themselves

MISE
    ;;

  ""|-h|--help) usage ;;
  *) error "Unknown command: $cmd"; echo; usage; exit 1 ;;
esac
