#!/usr/bin/env bash
# One entry point for everything. Run `sys` with no arguments for help.
set -euo pipefail

export ROOT_DIR="${ROOT_DIR:-$HOME/.system-config}"
source "$ROOT_DIR/lib/common.sh"
source "$ROOT_DIR/lib/sync.sh"
source "$ROOT_DIR/lib/setup.sh"

usage() {
  cat <<'USAGE'
sys — system configuration

  sys setup     Set up this machine from scratch
  sys sync      Pull the latest config and apply it to this machine
  sys push      Save this machine's config into the repo and push
  sys doctor    Check that everything is where it should be
  sys edit      Open this config folder in VS Code
  sys ssh       List the hosts you can reach over SSH
  sys alias     List your custom aliases and functions
  sys mise      How to use mise for language versions
  sys extras    Install the optional extras (Office, Xcode, ollama, duckdb)
  sys dock      Rebuild the Dock from config/dock
  sys hostname  Set the computer name (asks, or pass one: sys hostname my-mac)
  sys remove    Undo everything setup installed (asks first; --dryrun to preview)

Options
  --dry-run           Show what would happen, change nothing
  --yes               Don't ask for confirmation
  --name NAME         (setup) Set the computer name
  --no-brew           (setup) Skip Homebrew and packages
  --no-macos          (setup/sync) Skip macOS defaults
  --mas               (setup) Only install App Store apps

Full documentation: man sys
USAGE
}

cmd="${1:-}"; [[ $# -gt 0 ]] && shift

DO_BREW=1 DO_MACOS=1 ONLY="" NAME="" ARG=""
export DRY_RUN="${DRY_RUN:-0}" ASSUME_YES="${ASSUME_YES:-0}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run|--dryrun) DRY_RUN=1 ;;
    --force)    export FORCE=1 ;;
    --yes|-y)   ASSUME_YES=1 ;;
    --no-brew)  DO_BREW=0 ;;
    --no-macos) DO_MACOS=0 ;;
    --mas)      ONLY="mas" ;;
    --name)     NAME="${2:-}"; shift ;;
    -*) die "Unknown option: $1" ;;
    *)  ARG="$1" ;;
  esac
  shift
done

case "$cmd" in
  setup)
    is_macos || die "macOS only."

    case "$ONLY" in
      mas)      install_app_store_apps; exit 0 ;;
    esac

    confirm "Set up this machine from $ROOT_DIR?" || exit 0

    cat <<'HEADSUP'

This takes 15-30 minutes. Two things to expect:

  * You will be asked for your password. Type it and press Return once —
    it will not appear on screen, which is normal.
  * Some apps install with no output for several minutes. That is not a
    hang. Leave it alone.

HEADSUP

    STARTED=$SECONDS
    header "🚀" "Setting up this Mac"
    STEP=0; TOTAL=7; FAILED=""
    # Output is never piped: buffering would make a slow step look frozen.
    step() {
      local name="$1"; shift
      STEP=$((STEP + 1))
      printf '\n%s[%s/%s]%s %s%s%s\n' "$DIM" "$STEP" "$TOTAL" "$RESET" "$BOLD" "$name" "$RESET"
      if "$@"; then :; else
        FAILED="$FAILED|$name"
        warn "$name did not finish — carrying on"
      fi
      return 0
    }

    [[ -n "$NAME" ]] && sudo -v
    [[ "$DO_BREW" == "1" ]] && step "Installing apps and tools"  install_packages
    step "Installing dotfiles"          sync_install
    step "Installing language versions" install_languages
    step "Installing Cursor extensions" install_editor_extensions
    step "Installing MailExporter"      install_mail_exporter
    step "Installing App Store apps"    install_app_store_apps
    if [[ -n "$NAME" ]]; then
      set_machine_name "$NAME"
    else
      run_once hostname asked prompt_machine_name
    fi
    if [[ "$DO_MACOS" == "1" ]]; then
      step "Applying macOS defaults" apply_macos_defaults
      run_once dock "$(fingerprint "$ROOT_DIR/config/dock")" configure_dock
      set_default_terminal || true
    fi

    echo
    if [[ -n "$FAILED" ]]; then
      warn "Finished in $(elapsed $((SECONDS - STARTED))), but these steps had problems:"
      printf '%s' "$FAILED" | tr '|' '\n' | sed '/^$/d;s/^/      /'
    else
      ok "All 7 steps completed in $(elapsed $((SECONDS - STARTED)))"
    fi

    echo
    "$0" doctor || true
    print_manual_steps
    ;;

  sync)
    doing "Fetching latest config"
    before="$(git -C "$ROOT_DIR" rev-parse HEAD 2>/dev/null || echo none)"
    run git -C "$ROOT_DIR" pull --ff-only
    after="$(git -C "$ROOT_DIR" rev-parse HEAD 2>/dev/null || echo none)"

    # Install Brewfile changes, but only when the Brewfile actually moved:
    # brew bundle is idempotent yet slow enough to spoil a no-op sync.
    brew_changed=0
    if [[ "$before" != "$after" ]] &&
       ! git -C "$ROOT_DIR" diff --quiet "$before" "$after" -- Brewfile 2>/dev/null; then
      brew_changed=1
    fi
    [[ "${FORCE:-0}" == "1" ]] && brew_changed=1

    sync_install

    if [[ "$before" == "$after" && "${SYNC_CHANGED:-0}" == "0" && "$brew_changed" == "0" && "${FORCE:-0}" != "1" ]]; then
      ok "Already up to date — nothing to apply"
    else
      if [[ "${FORCE:-0}" == "1" ]]; then
        doing "Forced — reinstalled ${SYNC_CHANGED} file(s)"
      elif [[ "${SYNC_CHANGED:-0}" != "0" ]]; then
        doing "Installed ${SYNC_CHANGED} changed file(s)"
      fi
      # Never --cleanup: that would uninstall anything installed by hand.
      if [[ "$brew_changed" == "1" && "$DO_BREW" == "1" ]]; then
        doing "Brewfile changed — installing packages"
        install_packages
      fi
      [[ "$DO_MACOS" == "1" ]] && apply_macos_defaults
      ok "Done — run 'exec zsh' (or rp) to reload your shell"
    fi
    ;;

  push)
    doing "Saving this machine's config into the repo"
    sync_backup
    # keep the Cursor extension list from drifting
    has_cmd cursor && cursor --list-extensions 2>/dev/null | sort > "$ROOT_DIR/config/cursor-extensions.txt"
    # capture the Dock as it is now
    "$ROOT_DIR/bin/dump-dock" >/dev/null 2>&1 || true
    if [[ -n "$(git -C "$ROOT_DIR" status --porcelain)" ]]; then
      git -C "$ROOT_DIR" add -A
      git -C "$ROOT_DIR" commit -m "Update config files"
      run git -C "$ROOT_DIR" push
      ok "Pushed"
    else
      note "Nothing changed"
    fi
    ;;

  doctor)
    # One emoji per row, then a fixed-width label, so columns line up even
    # though emoji are double width.
    row() { printf '  %s  %s%-9s%s %s\n' "$1" "$BOLD" "$2" "$RESET" "$3"; }
    good() { printf '%s%s%s' "$GREEN"  "$1" "$RESET"; }
    bad()  { printf '%s%s%s' "$YELLOW" "$1" "$RESET"; }
    issues=0

    header "🩺" "System check"

    tools="git brew mise uv gh jq mas duti"; missing=""
    for t in $tools; do has_cmd "$t" || missing="$missing $t"; done
    if [[ -z "$missing" ]]; then
      row "🧰" "Tools" "$(good "all present") ${DIM}$(echo $tools | sed 's/ /, /g')${RESET}"
    else
      row "🧰" "Tools" "$(bad "missing:$(echo $missing | sed 's/ /, /g')")"; issues=1
    fi

    if has_cmd mise; then
      while read -r tool ver _; do
        case "$tool" in
          ruby)   row "💎" "Ruby"   "$(good "$ver")" ;;
          node)   row "📗" "Node"   "$(good "$ver")" ;;
          python) row "🐍" "Python" "$(good "$ver")" ;;
        esac
      done < <(mise ls --current 2>/dev/null)
    fi


    if has_cmd mas; then
      if with_timeout 10 mas list; then row "🛒" "App Store" "$(good reachable)"
      else row "🛒" "App Store" "$(bad "not signed in")"; issues=1; fi
    fi

    if [[ -e "$ROOT_DIR/.state/dock" ]]; then
      row "🚀" "Dock" "$(good "set up")"
    else
      row "🚀" "Dock" "${DIM}not set up yet — sys dock${RESET}"
    fi

    if git -C "$ROOT_DIR" rev-parse --git-dir >/dev/null 2>&1; then
      if [[ -z "$(git -C "$ROOT_DIR" status --porcelain)" ]]; then
        row "📦" "Repo" "$(good clean)"
      else
        row "📦" "Repo" "$(bad "uncommitted changes") ${DIM}sys push${RESET}"; issues=1
      fi
    else
      row "📦" "Repo" "$(bad "not a git repo")"; issues=1
    fi

    echo
    if [[ "$issues" == "0" ]]; then
      printf '  ✅  %sEverything looks good.%s\n\n' "$GREEN" "$RESET"
    else
      printf '  🔧  %sSome things need attention above.%s\n\n' "$YELLOW" "$RESET"
    fi
    ;;

  alias|aliases)
    file="$ROOT_DIR/dotfiles/.aliases"
    [[ -r "$file" ]] || die "Not found: $file"
    awk -v g="$GREEN" -v c="$CYAN" -v y="$YELLOW" -v r="$RESET" '
      # A comment containing box-drawing rule is a section header. Tested
      # byte-wise with index() so it works whatever locale awk runs in.
      /^#/ {
        if (index($0, "\xe2\x94\x80") > 0) {
          h = $0
          gsub(/[^ -~]/, "", h)          # strip non-ASCII (the rule)
          sub(/^# */, "", h); sub(/ *$/, "", h)
          if (h != "") printf "\n%s%s%s\n", c, h, r
          desc = ""; next
        }
        desc = $0; sub(/^# */, "", desc); next
      }
      # alias name='"'"'command'"'"'   (trailing # comment is the description)
      /^alias / {
        line = $0; sub(/^alias /, "", line)
        eq = index(line, "=")
        name = substr(line, 1, eq - 1)
        rest = substr(line, eq + 1)
        note = ""
        if (match(rest, /[ \t]+#[ \t]*/)) {
          note = substr(rest, RSTART + RLENGTH)
          rest = substr(rest, 1, RSTART - 1)
        }
        gsub(/^['"'"'"]|['"'"'"]$/, "", rest)
        printf "  %s%-8s%s %s%s%s\n", g, name, r, y, rest, r
        if (note != "") printf "  %8s   %s\n", "", note
        desc = ""; next
      }
      # shell function:  name() {
      /^[a-z_][a-z0-9_]*\(\)/ {
        fn = $0; sub(/\(\).*/, "", fn)
        printf "  %s%-8s%s %s%s%s\n", g, fn, r, y, (desc == "" ? "function" : desc), r
        desc = ""; next
      }
      { desc = "" }
    ' "$file"
    proj="$ROOT_DIR/dotfiles/.projects"
    if [[ -r "$proj" ]]; then
      printf '\n%sProject starters%s\n' "$CYAN" "$RESET"
      grep -E "^[a-z]+\(\)  *\{ _new_project" "$proj" | while read -r l; do
        n="${l%%(*}"; d="$(printf '%s' "$l" | sed -E 's/.*_new_project ([^ ]+).*/\1/')"
        printf '  %s%-8s%s %s%s%s\n' "$GREEN" "$n" "$RESET" "$YELLOW" "$d" "$RESET"
      done
    fi
    echo
    ;;

  remove)
    is_macos || die "macOS only."
    remove_everything
    ;;

  ssh)
    "$ROOT_DIR/bin/ssh-hosts"
    ;;

  edit)
    if has_cmd code; then
      doing "Opening $ROOT_DIR in VS Code"
      code "$ROOT_DIR"
    else
      die "VS Code's 'code' command is not on PATH. Open it from VS Code with Shell Command: Install 'code' command in PATH."
    fi
    ;;

  hostname)
    is_macos || die "macOS only."
    if [[ -n "$ARG" ]]; then set_machine_name "$ARG"; else prompt_machine_name; fi
    mkdir -p "$ROOT_DIR/.state" && printf 'asked\n' > "$ROOT_DIR/.state/hostname"
    ;;

  dock)
    is_macos || die "macOS only."
    if configure_dock; then
      mkdir -p "$ROOT_DIR/.state"
      fingerprint "$ROOT_DIR/config/dock" > "$ROOT_DIR/.state/dock"
    else
      die "The Dock was not set up."
    fi
    ;;

  extras)
    is_macos || die "macOS only."
    install_extras
    ;;

  mise)
    cat <<'MISE'

mise manages your Ruby, Node and Python versions.

  Global versions live in ~/.config/mise/config.toml, tracked in this repo as
  dotfiles/.config/mise/config.toml. Edit it, run `sys push`, then `mise install`.

Everyday
  mise ls                     what is installed, and what is active here
  mise current                just the active versions
  mise install                install everything the config asks for
  mise outdated               what has newer versions available
  mise upgrade                move up within the versions you have pinned

Change a version
  mise use -g ruby@3.4.8      change the GLOBAL default (edits the config)
  mise use ruby@3.3           pin for THIS project (writes ./mise.toml)
  mise ls-remote ruby         what versions exist
  mise exec ruby@3.2 -- ruby -v    run once, change nothing

Per project
  A ./mise.toml overrides the global versions and activates when you cd in.
  mise trust                  allow a mise.toml you did not write

Python packages
  mise supplies the interpreter; uv does packages and virtualenvs.
  uv venv                     create .venv with the active python
  uv pip install -r requirements.txt
  uv add <pkg>                for pyproject.toml projects
  uv run <script.py>          run in the project env, installing as needed

Where things live
  ~/.config/mise/config.toml       global versions (tracked in this repo)
  ./mise.toml                      per-project override (commit it)
  ~/.local/share/mise/installs     the toolchains themselves

MISE
    ;;

  ""|-h|--help) usage ;;
  *) error "Unknown command: $cmd"; echo; usage; exit 1 ;;
esac
